{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sample settings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "information",
        "warning",
        "error",
        "off",
        "trce",
        "dbug",
        "info",
        "warn",
        "fail"
      ],
      "description": "The lowest level to log. A spelling matches ignoring case."
    },
    "size": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]\u002B$"
        }
      ],
      "description": "The buffer size in bytes."
    },
    "output": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "console",
            "file"
          ],
          "description": "The kind of output. A spelling matches ignoring case."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "The file to write to."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^[^:]\u002B(:[^:]\u002B)\u002B$": true
      },
      "description": "Where the log goes."
    }
  },
  "required": [
    "size"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^[^:]\u002B(:[^:]\u002B)\u002B$": true
  }
}

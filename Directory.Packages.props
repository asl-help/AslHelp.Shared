<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Shared package versions. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <!-- Global packages. -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Polyfill" Version="1.0.168" />
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <MeziantouPolyfill_IncludedPolyfills>
      M:System.ArgumentNullException.ThrowIfNull(System.Object,System.String);
      M:System.ArgumentOutOfRangeException.ThrowIfGreaterThan``1(``0,``0,System.String);
      M:System.ArgumentOutOfRangeException.ThrowIfLessThan``1(``0,``0,System.String);
      M:System.Collections.Generic.Dictionary`2.TryAdd(`0,`1);
      M:System.Collections.Generic.KeyValuePair`2.Deconstruct(`0@,`1@);
      T:System.Diagnostics.CodeAnalysis.DoesNotReturnAttribute;
      T:System.Diagnostics.CodeAnalysis.MaybeNullWhenAttribute;
      T:System.Diagnostics.CodeAnalysis.MemberNotNullWhenAttribute;
      T:System.Diagnostics.CodeAnalysis.NotNullAttribute;
      T:System.Diagnostics.CodeAnalysis.NotNullWhenAttribute;
      T:System.Diagnostics.CodeAnalysis.SetsRequiredMembersAttribute;
      T:System.HashCode;
      T:System.Index;
      T:System.Range;
      T:System.Runtime.CompilerServices.CallerArgumentExpressionAttribute;
      T:System.Runtime.CompilerServices.CompilerFeatureRequiredAttribute;
      T:System.Runtime.CompilerServices.InterpolatedStringHandlerArgumentAttribute;
      T:System.Runtime.CompilerServices.InterpolatedStringHandlerAttribute;
      T:System.Runtime.CompilerServices.IsExternalInit;
      T:System.Runtime.CompilerServices.RequiredMemberAttribute;
    </MeziantouPolyfill_IncludedPolyfills>
  </PropertyGroup>

</Project>
